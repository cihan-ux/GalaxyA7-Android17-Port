## Device Path
DEVICE_PATH := device/samsung/a7y18lte

## Include common BoardConfig
include device/samsung/exynos7885-common/BoardConfigCommon.mk

# Fingerprint
TARGET_SEC_FP_HAS_FINGERPRINT_GESTURES := true

# Kernel
TARGET_KERNEL_CONFIG := lineage_a7y18lte_defconfig

# Partitions
BOARD_SUPER_PARTITION_METADATA_DEVICE := SYSTEM
BOARD_SUPER_PARTITION_BLOCK_DEVICES := SYSTEM VENDOR ODM
BOARD_SUPER_PARTITION_ODM_DEVICE_SIZE := 369098752
BOARD_SUPER_PARTITION_SYSTEM_DEVICE_SIZE := 4093640704
BOARD_SUPER_PARTITION_VENDOR_DEVICE_SIZE := 419430400
BOARD_SUPER_PARTITION_SIZE := 4882169856
BOARD_SAMSUNG_DYNAMIC_PARTITIONS_SIZE := 4878169856

BOARD_BOOTIMAGE_PARTITION_SIZE := 33554432
BOARD_CACHEIMAGE_PARTITION_SIZE := 262144000
BOARD_RECOVERYIMAGE_PARTITION_SIZE := 39845888

# SKU
ODM_MANIFEST_SKUS += SM-A750FN SM-A750GN
ODM_MANIFEST_SM-A750FN_FILES := $(DEVICE_PATH)/manifest_nfc.xml
ODM_MANIFEST_SM-A750GN_FILES := $(DEVICE_PATH)/manifest_nfc.xml

# Vintf
DEVICE_MANIFEST_FILE += $(DEVICE_PATH)/manifest.xml

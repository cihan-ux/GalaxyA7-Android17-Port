        <transport>hwbinder</transport>
    </hal>
    <hal format="hidl" override="true">
        <name>vendor.lineage.touch</name>
        <transport>hwbinder</transport>
        <version>1.0</version>
        <interface>
            <name>IGloveMode</name>
            <instance>default</instance>
        </interface>
        <interface>
            <name>IStylusMode</name>
            <instance>default</instance>
        </interface>
